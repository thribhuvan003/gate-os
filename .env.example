# ── Supabase (GATE OS project) ────────────────────────────────────────────────
# Project dashboard: https://supabase.com/dashboard/project/<project-ref>
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy JWT anon key — kept as a fallback; the publishable key above is preferred.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Invite gating ─────────────────────────────────────────────────────────────
# Random string, 32+ characters. Signs the short-lived beta-invite cookie.
GATE_OS_INVITE_COOKIE_SECRET=
# The email allowed to open /admin and mint invite codes.
ADMIN_EMAIL=

# ── App ───────────────────────────────────────────────────────────────────────
# Public origin of this deployment, no trailing slash.
# Used to build circle-invitation links. MUST be the real production URL in prod.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be an address on a VERIFIED Resend domain, e.g. "GATE OS <gateos@yourdomain.com>".
# Weekly summary emails are silently skipped while this is empty.
RESEND_FROM_EMAIL=

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Cron ──────────────────────────────────────────────────────────────────────
# Bearer secret protecting /api/cron/weekly-summary.
# When set in Vercel, Vercel Cron automatically sends it as the Authorization header.
CRON_SECRET=
